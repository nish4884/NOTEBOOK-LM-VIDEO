{
  "name": "notebooklm-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Google NotebookLM bangla explainer — Remotion motion graphics",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/video.mp4",
    "still": "remotion still src/index.ts Main out/still.png --frame=300",
    "cues": "node scripts/make-cues.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "check-sfx": "node scripts/check-sfx.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.0"
  }
}
